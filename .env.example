# ===== AI (필수) : https://aistudio.google.com/apikey =====
GEMINI_API_KEY=
# 선택: config.yaml 의 gemini.model 대신 사용할 모델명
# GEMINI_MODEL=gemini-flash-latest

# ===== 시각자료 (선택, 둘 다 무료) =====
# https://www.pexels.com/api/
PEXELS_API_KEY=
# https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# ===== AI 이미지 대체 1 (무료) : Cloudflare Workers AI =====
# Account ID: dash.cloudflare.com → Workers AI → "REST API 사용" / API Token: "Workers AI" 템플릿으로 생성
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ===== AI 이미지 대체 2 (크레딧 필요) : https://huggingface.co/settings/tokens =====
# Fine-grained 토큰 → "Make calls to Inference Providers" 권한 체크 필요
HF_API_KEY=

# ===== 이미지 → 영상 (선택) : 智谱 BigModel CogVideoX-Flash =====
# 2026-10-17 기준 무료 한도·상업적 이용 조건 미확인(unverified) → 키를 넣어도 호출하지 않는다 (README 16절)
ZHIPU_API_KEY=

# ===== YouTube Data API v3 (production 업로드 시 필수) =====
# Google Cloud Console → OAuth 클라이언트 ID (데스크톱 앱)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ===== 트렌드 탐색 (선택) =====
# YouTube Data API Key (트렌드 신호 조회용, 무료 할당량). 비우면 token.json(OAuth, youtube.readonly)으로 조회
# Google Cloud Console → API 및 서비스 → 사용자 인증 정보 → API 키 (YouTube Data API v3 로 제한 권장)
YOUTUBE_API_KEY=
# Google Trends 공식 API 는 알파(승인자만). 승인받은 경우에만 입력 + config.yaml trends.google_trends.enabled
GOOGLE_TRENDS_API_KEY=
# 위키백과 조회수(Wikimedia Pageviews API)는 Key 불필요

# ===== YouTube Analytics (성과 수집) =====
# 별도 Key 없음. token.json 에 yt-analytics.readonly 권한이 있어야 한다 → `python -m app.main auth` 로 재인증
# (권한이 없으면 공개 통계만 수집하고 제작/업로드는 그대로 동작)

# 선택: config.yaml 의 app.mode 덮어쓰기 (development | production)
# APP_MODE=development
