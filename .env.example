# ===== AI (필수) : https://aistudio.google.com/apikey =====
GEMINI_API_KEY=
# 선택: config.yaml 의 gemini.model 대신 사용할 모델명
# GEMINI_MODEL=gemini-flash-latest

# ===== 시각자료 (선택, 둘 다 무료) =====
# https://www.pexels.com/api/
PEXELS_API_KEY=
# https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# ===== AI 이미지 대체 1 (무료) : Cloudflare Workers AI =====
# Account ID: dash.cloudflare.com → Workers AI → "REST API 사용" / API Token: "Workers AI" 템플릿으로 생성
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ===== AI 이미지 대체 2 (크레딧 필요) : https://huggingface.co/settings/tokens =====
# Fine-grained 토큰 → "Make calls to Inference Providers" 권한 체크 필요
HF_API_KEY=

# ===== YouTube Data API v3 (production 업로드 시 필수) =====
# Google Cloud Console → OAuth 클라이언트 ID (데스크톱 앱)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# 선택: config.yaml 의 app.mode 덮어쓰기 (development | production)
# APP_MODE=development
